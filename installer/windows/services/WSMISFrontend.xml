<service>
  <id>WSMISFrontend</id>
  <name>WSMIS Desktop Web Application</name>
  <description>Local Next.js interface for the Water Supply Management Information System.</description>
  <executable>%BASE%\..\runtime\node\node.exe</executable>
  <arguments>server.js</arguments>
  <workingdirectory>%BASE%\..\frontend</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="HOSTNAME" value="127.0.0.1" />
  <env name="PORT" value="3000" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>WSMISBackend</depend>
  <stoptimeout>20sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%ProgramData%\WSMIS\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
